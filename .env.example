NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used only by `npm run supabase:seed-live`.
STRATA_ADMIN_EMAIL=
STRATA_ADMIN_PASSWORD=
STRATA_MEMBER_EMAIL=
STRATA_MEMBER_PASSWORD=

# Local Vercel AI Gateway auth is normally provided by `vercel env pull .env.local`.
# The app returns safe mock AI responses when credentials are absent.
VERCEL_OIDC_TOKEN=
AI_GATEWAY_API_KEY=
