STRATA_ENVIRONMENT=local
STRATA_DATA_MODE=live
STRATA_STAGING_SUPABASE_PROJECT_REF=
STRATA_PRODUCTION_SUPABASE_PROJECT_REF=
STRATA_ALLOW_REMOTE_TEST_MUTATIONS=0
STRATA_STAGING_BROWSER_ORIGIN=
STRATA_PRODUCTION_BROWSER_ORIGIN=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase Auth user UUID for the sole Eve draft approver (repository operator/owner).
STRATA_EVE_APPROVER_USER_ID=

# Temporary compatibility aliases; prefer the names above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used only by `npm run supabase:seed-live`.
STRATA_ADMIN_EMAIL=
STRATA_ADMIN_PASSWORD=
STRATA_MEMBER_EMAIL=
STRATA_MEMBER_PASSWORD=

# v1 defaults to verified fallback. Live Gateway requires the exact value `live`
# plus Vercel OIDC or an AI Gateway API key; invalid or absent values fail closed.
STRATA_AI_RELEASE_MODE=fallback

# Local Vercel AI Gateway auth is normally provided by `vercel env pull .env.local`.
VERCEL_OIDC_TOKEN=
AI_GATEWAY_API_KEY=
