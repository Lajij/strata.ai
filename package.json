{
  "name": "strata",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "eve build && next build",
    "build:eve": "eve build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "verify:e2e": "playwright test",
    "verify:e2e:report": "playwright show-report",
    "verify:fallback-build": "node scripts/verify-fallback-build.mjs",
    "verify:fail-closed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-fail-closed.mjs && node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/verify-fail-closed-routes.mjs && STRATA_TEST_UPSTREAM_FAILURES=1 node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --experimental-loader ./scripts/test-alias-loader.mjs scripts/verify-upstream-failures.mjs && node scripts/verify-mutation-targets.mjs",
    "verify:mutation-targets": "node scripts/verify-mutation-targets.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:migrations:reconciliation": "node scripts/verify-migration-reconciliation.mjs",
    "verify:migrations:replay": "node scripts/verify-migrations-replay.mjs",
    "verify:capabilities": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-capabilities.mjs",
    "verify:capabilities:rls": "node scripts/verify-capability-rls.mjs",
    "supabase:push:dry-run": "node scripts/safe-supabase-push.mjs --dry-run",
    "supabase:push:schema": "node scripts/safe-supabase-push.mjs",
    "verify:production-ready": "node scripts/verify-production-ready.mjs",
    "verify:auth-flow": "node scripts/verify-auth-flow.mjs",
    "verify:recovery": "node scripts/verify-recovery-source.mjs",
    "verify:recovery-browser": "node scripts/verify-recovery-browser.mjs",
    "verify:member-management": "node scripts/verify-member-management.mjs",
    "verify:budget": "node scripts/verify-budget-workflow.mjs",
    "verify:quote-invoice": "node scripts/verify-quote-invoice-workflow.mjs",
    "verify:browser-workflow": "node scripts/verify-browser-workflow.mjs",
    "verify:auth-browser": "node scripts/verify-auth-browser.mjs",
    "verify:documents": "node scripts/verify-document-workflow.mjs",
    "verify:documents-ui": "node scripts/verify-documents-source.mjs",
    "verify:frontend-qa-browser": "node scripts/verify-frontend-qa-browser.mjs",
    "verify:ai": "node scripts/verify-ai-layer.mjs",
    "verify:ai-browser": "node scripts/verify-ai-browser.mjs",
    "verify:ai-observability": "node scripts/verify-ai-observability.mjs",
    "verify:law": "node scripts/verify-law-sources.mjs",
    "verify:live-dashboard": "node scripts/verify-live-dashboard-data.mjs",
    "verify:dashboard": "node scripts/verify-dashboard-source.mjs",
    "verify:projects": "node scripts/verify-projects-source.mjs",
    "verify:admin": "node scripts/verify-admin-source.mjs",
    "verify:drilldown": "node scripts/verify-drilldown-source.mjs",
    "verify:search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-search-source.mjs",
    "verify:eve-tools": "node scripts/verify-eve-tools.mjs",
    "verify:eve-evals": "node scripts/verify-eve-evals.mjs && STRATA_EVE_EVAL_FIXTURE=1 eve eval --strict --skip-report --max-concurrency 1",
    "verify:workflow-ui": "node scripts/verify-workflow-ui-source.mjs",
    "verify:frontend-contract": "node scripts/verify-frontend-contract.mjs",
    "verify:security": "node scripts/verify-rls-and-ai-context.mjs",
    "export:ai-audit": "node scripts/export-ai-audit-pack.mjs",
    "seed:law": "node scripts/seed-nsw-law-sources.mjs",
    "supabase:seed-live": "node scripts/seed-live-workspace.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.51",
    "@base-ui/react": "^1.5.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "ai": "^7.0.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eve": "^0.29.4",
    "lucide-react": "^1.21.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "2.111.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
