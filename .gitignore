# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright e2e artefacts (report, screenshots, traces, persona state)
/playwright-report/
/test-results/
/blob-report/
/e2e/.persona-state.json
/e2e/.storage/

# next.js
/.next/
/out/

# production
/build
/.eve/
/.output/

# Supabase CLI local state
/supabase/.branches/
/supabase/.temp/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
